[Unit]
Description=MassChange ingest crawler
Requires=mango-ensure.service
After=mango-ensure.service
Wants=mango-db.service
After=mango-db.service
StartLimitIntervalSec=0

[Container]
ContainerName=mango-crawler
Image=localhost/masschange:1.0.0
Network=mango-backend.network
EnvironmentFile=%h/.config/mango/mango.env
Secret=mango-db-password,type=env,target=TSDB_PASSWORD

# The whole data root as a SINGLE bind mount. This is deliberate: input and
# staging must share one mount so the crawler's os.rename() does not fail with
# EXDEV. Mounting the two subdirectories separately would break it.
# CAVEAT: this also exposes /soft/mango/tsdb-persist inside the container as
# /data/tsdb-persist, writable, to a process running --remove-src-files.
# Recommended fix: move tsdb-persist and logs OUT of DATA_ROOT.
Volume=/soft/mango:/data:rw

# /input and /staging are symlinks created by entrypoint.sh from
# DATA_ROOT + the *_SUBPATH variables.
Exec=python /app/masschange/src/masschange/ingest/crawler/main.py --src /input --dest /staging --remove-src-files --loop

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
