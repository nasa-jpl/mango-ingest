# systemd EnvironmentFile. NOTE: quoting rules differ from docker-compose .env
# files - values are written unquoted here deliberately.
#
# This file contains CONTAINER-SIDE values only. Host paths appear exclusively
# in the Volume= lines of the .container units, because Quadlet performs no
# variable expansion in [Container] keys.
#
# DB_PASSWORD is deliberately absent - it is a podman secret now.

API_PROXY_HOST=pretendhost.jpl.nasa.gov
API_ROOT_PATH=/mango/api/
API_ENABLE_SSL=1

# Container-side data root (host /soft/mango is bind-mounted here).
DATA_ROOT=/data
SOURCE_DATA_ROOT_SUBPATH=input-data-dropbox
STAGED_DATA_ROOT_SUBPATH=ingest-manager-staged-data

TSDB_HOST=mango-db
TSDB_PORT=5432

# Container-side path only. The host path (/mango/offred_fields_metadata.json)
# lives in the worker units' Volume= lines.
OFFRED_METADATA_FILEPATH=/sensitive/offred_fields_metadata.json

# Referenced nowhere in the compose file - carried over pending confirmation
# that something consumes it.
OFFRED_AGGREGATE=NONE
